# Copier en `.env.local` et renseigner les valeurs du projet Supabase.
# Ces deux valeurs sont publiques (destinées au frontend) : la sécurité repose sur la RLS,
# pas sur leur secret. Ne JAMAIS mettre ici le mot de passe database ni la secret key.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
